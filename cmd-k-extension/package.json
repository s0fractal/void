{
  "name": "cursor-cmd-k-gene",
  "displayName": "Cursor Cmd+K Gene",
  "description": "Cursor's Cmd+K inline AI editing - extracted gene for any VSCode",
  "version": "0.1.0",
  "publisher": "chimera-collective",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onCommand:cursorGene.inlineEdit"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cursorGene.inlineEdit",
        "title": "AI: Inline Edit (Cursor Style)"
      }
    ],
    "keybindings": [
      {
        "command": "cursorGene.inlineEdit",
        "key": "cmd+k",
        "when": "editorTextFocus && !editorReadonly"
      }
    ],
    "configuration": {
      "title": "Cursor Cmd+K Gene",
      "properties": {
        "cursorGene.aiProvider": {
          "type": "string",
          "default": "mock",
          "enum": ["mock", "openai", "anthropic"],
          "description": "AI provider (mock for demo)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "typescript": "^4.9.5"
  }
}